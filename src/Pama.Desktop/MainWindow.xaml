<Window x:Class="Pama.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Generator.Title}" Icon="Assets/pama.ico"
        Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="GroupName" Value="Kind" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SmallCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </Window.Resources>

    <!-- No in-window header: the title bar already shows the icon and name -->
    <StackPanel Margin="16,12,16,6">
        <Border CornerRadius="6" Padding="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <UniformGrid x:Name="KindPanel" Rows="1">
                <RadioButton Style="{StaticResource Segment}" Tag="Password" IsChecked="True"
                             Content="{DynamicResource Generator.Kind.Password}"
                             ToolTip="{DynamicResource Generator.Hint.Password}" Checked="OnKindChanged" />
                <RadioButton Style="{StaticResource Segment}" Tag="Hex"
                             Content="{DynamicResource Generator.Kind.Hex}"
                             ToolTip="{DynamicResource Generator.Hint.Hex}" Checked="OnKindChanged" />
                <RadioButton Style="{StaticResource Segment}" Tag="Base64Url"
                             Content="{DynamicResource Generator.Kind.Base64Url}"
                             ToolTip="{DynamicResource Generator.Hint.Base64Url}" Checked="OnKindChanged" />
                <RadioButton Style="{StaticResource Segment}" Tag="Pin"
                             Content="{DynamicResource Generator.Kind.Pin}"
                             ToolTip="{DynamicResource Generator.Hint.Pin}" Checked="OnKindChanged" />
            </UniformGrid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <!-- Fixed height: changing length or type must not make the window jump -->
                <TextBox x:Name="OutputTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Padding="0"
                         Height="56" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" />

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                            Content="&#xE72C;" ToolTip="{DynamicResource Generator.Regenerate}"
                            Click="OnGenerateClick" />
                    <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="OnRevealClick" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <ProgressBar x:Name="StrengthBar" Height="3" Maximum="128" />
                        <TextBlock x:Name="StrengthText" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Button x:Name="CopyButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" Height="32" IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" ToolTip="Enter / Ctrl+C" Click="OnCopyClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CopyIcon" FontFamily="{StaticResource IconFont}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="CopyLabel" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <ProgressBar x:Name="CountdownBar" Height="2" Margin="0,4,0,0" Visibility="Hidden" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="18">
            <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="LengthValue" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}"
                               FontSize="12" VerticalAlignment="Center" Width="32" TextAlignment="Right" />
                    <TextBlock x:Name="LengthLabel" FontSize="12" VerticalAlignment="Center" Width="64" />
                    <Slider x:Name="LengthSlider" IsSnapToTickEnabled="True" TickFrequency="1"
                            SmallChange="1" LargeChange="4" VerticalAlignment="Center"
                            ValueChanged="OnLengthChanged" />
                </DockPanel>

                <StackPanel x:Name="PasswordPanel" Margin="0,8,0,0">
                    <UniformGrid Rows="1">
                        <ToggleButton x:Name="LowercaseToggle" Style="{StaticResource Chip}" IsChecked="True"
                                      Content="{DynamicResource Generator.Lowercase}" Click="OnPasswordOptionChanged" />
                        <ToggleButton x:Name="UppercaseToggle" Style="{StaticResource Chip}" IsChecked="True"
                                      Content="{DynamicResource Generator.Uppercase}" Click="OnPasswordOptionChanged" />
                        <ToggleButton x:Name="DigitsToggle" Style="{StaticResource Chip}" IsChecked="True"
                                      Content="{DynamicResource Generator.Digits}" Click="OnPasswordOptionChanged" />
                        <ToggleButton x:Name="SymbolsToggle" Style="{StaticResource Chip}" IsChecked="True"
                                      Content="{DynamicResource Generator.Symbols}" Click="OnPasswordOptionChanged" />
                    </UniformGrid>
                    <CheckBox x:Name="ExcludeAmbiguousCheckBox" Style="{StaticResource SmallCheckBox}"
                              Margin="0,6,0,0" Content="{DynamicResource Generator.ExcludeAmbiguous}"
                              Click="OnPasswordOptionChanged" />
                </StackPanel>

                <CheckBox x:Name="AutoClearCheckBox" Style="{StaticResource SmallCheckBox}" IsChecked="True"
                          Content="{DynamicResource Generator.AutoClear}" Click="OnAutoClearChanged" />
                <CheckBox x:Name="CloseToTrayCheckBox" Style="{StaticResource SmallCheckBox}" IsChecked="True"
                          Content="{DynamicResource Settings.CloseToTray}" Click="OnCloseToTrayChanged" />
                <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource SmallCheckBox}"
                          Content="{DynamicResource Settings.StartWithWindows}" Click="OnStartWithWindowsChanged" />
            </StackPanel>
        </Border>

        <Button x:Name="VersionButton" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="6,2" FontSize="11"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                ToolTip="{DynamicResource Changelog.Title}" Click="OnVersionClick" />
    </StackPanel>
</Window>
