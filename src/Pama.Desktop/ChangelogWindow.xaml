<Window x:Class="Pama.Desktop.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Changelog.Title}" Width="480" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel Margin="24,16,24,20">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" MinWidth="96" Margin="0,16,0,0"
                IsCancel="True" IsDefault="True" Content="{DynamicResource Changelog.Close}" Click="OnCloseClick" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
