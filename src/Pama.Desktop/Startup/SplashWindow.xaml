<Window x:Class="Pama.Desktop.Startup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="150" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        FontFamily="Segoe UI">
    <!-- Runs on its own UI thread: only local resources, never Application.Resources (owned by the main thread).
         ShowActivated=False: the splash must never hold the foreground, or the main window opens behind other apps -->
    <Window.Resources>
        <ResourceDictionary Source="/Resources/Logo.xaml" />
    </Window.Resources>
    <Border CornerRadius="10" Background="#202028" BorderBrush="#3C3C48" BorderThickness="1" Padding="24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Logo}" Width="44" Height="44" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pama" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="#9696A5" FontSize="11" />
                </StackPanel>
            </StackPanel>
            <Grid Margin="0,22,0,0" Height="4">
                <Border CornerRadius="2" Background="#3C3C48" />
                <Border x:Name="ProgressFill" CornerRadius="2" Background="#7C5CF0" HorizontalAlignment="Left"
                        Width="0" />
            </Grid>
            <TextBlock x:Name="StepText" Margin="0,8,0,0" Foreground="#9696A5" FontSize="11" />
        </StackPanel>
    </Border>
</Window>
